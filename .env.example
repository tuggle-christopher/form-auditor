# Copy to .env (same folder) and fill in. .env is git-ignored - never commit keys.

# Azure AI Document Intelligence - reads the handwriting (--ocr azure / ocr="azure")
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_DI_KEY=<key>

# Blob storage - only for https://<account>.blob.core.windows.net/<container>/... paths.
# One of these is enough. (abfss:// paths use the access already set up on the cluster.)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# AZURE_STORAGE_SAS_TOKEN=sv=...
# AZURE_STORAGE_KEY=<account key>
